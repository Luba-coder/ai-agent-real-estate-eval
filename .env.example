# API вашего локального агента
AGENT_API_KEY=change-me
AGENT_HOST=127.0.0.1
AGENT_PORT=8004

# Базовый профиль: лучше для извлечения RentalAds
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=12288
MAX_HTML_CHARS=160000

# Облегчённый профиль для слабого ПК:
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_NUM_CTX=8192
# MAX_HTML_CHARS=60000

USER_AGENT=SemanticPriceScraper/1.0

# Langfuse: создать личный project и добавить ключи в .env
LANGFUSE_SECRET_KEY=ваш_секретный_ключ
LANGFUSE_PUBLIC_KEY=ваш_публичный_ключ
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# LangSmith: опционально
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=real-estate-agent-evaluation
# Таймаут отправки traces в LangSmith, полезно при медленной сети
LANGSMITH_TIMEOUT_MS=15000

# DeepEval: настройки локального evaluation-прогона
DEEPEVAL_OLLAMA_MODEL=qwen2.5:7b
EVALUATION_DATASET_PATH=data/evaluation_dataset.xlsx
EVALUATION_TEST_URL=https://www.rentalads.com/apartments-for-rent/ny/new-york/
EVALUATION_SESSION_ID=real-estate-eval-v1
EVALUATION_THRESHOLD=0.7
EVALUATION_SLEEP_SECONDS=1.0
AGENT_TIMEOUT_SECONDS=180

# Идентификатор пользователя в traces
AGENT_USER_ID=student_user