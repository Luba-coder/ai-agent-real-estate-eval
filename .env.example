# API вашего локального агента
AGENT_API_KEY=change-me
AGENT_HOST=127.0.0.1
AGENT_PORT=8004

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=8192

# HTML scraper
MAX_HTML_CHARS=20000
USER_AGENT=SemanticPriceScraper/1.0

# Langfuse: создать личный project и добавить ключи в .env
LANGFUSE_SECRET_KEY=ваш_секретный_ключ
LANGFUSE_PUBLIC_KEY=ваш_публичный_ключ
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# LangSmith: опционально
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=real-estate-agent-evaluation